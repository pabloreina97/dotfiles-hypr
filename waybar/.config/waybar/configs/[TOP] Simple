// ### TOP Simple ## //

{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"layer": "top", 
"position": "top", 
//"mode": "dock",
"exclusive": true,
"passthrough": false,
"gtk-layer-shell": true,
"margin-left": 0,
"margin-right": 0,
"margin-top": 0,

"modules-left": [
	"idle_inhibitor",
	"cpu",
	"memory",
	"disk",
	"temperature",
	"hyprland/workspaces#rw",
	"mpris",
	],

"modules-center": [
	"clock#5",
	"group/notify",
	],

"modules-right": [
	"custom/weather",
	"tray",
	"network",
	"bluetooth",
	"group/audio",
	"custom/nightlight",
	"custom/power",
	],
}

